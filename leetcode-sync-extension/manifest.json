{
  "manifest_version": 3,
  "name": "LeetCode Sync Pipeline",
  "version": "1.0",
  "description": "Automatically syncs solved LeetCode problems to your local DSA Journey tracker.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:8080/*",
    "https://dsaflow-kjkc.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
